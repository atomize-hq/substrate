+#[cfg(target_os = "linux")]
+async fn submit_authority_managed_host_targeted_turn(
+    identity: AuthorityManagedTargetedTurnIdentity,
+    prompt: &str,
+) -> Result<()> {
+    let prompt = prompt.to_string();
+    let exit_code = task::spawn_blocking(move || -> Result<i32> {
+        let world_flag = if identity.world_bound {
+            "--world"
+        } else {
+            "--no-world"
+        };
+        let cli = crate::execution::Cli::try_parse_from(["substrate", world_flag])
+            .context("build authority-managed targeted Turn invocation")?;
+        let command = crate::execution::AgentCmd {
+            action: crate::execution::AgentAction::Turn(crate::execution::AgentTurnArgs {
+                session: identity.orchestration_session_id,
+                backend: identity.backend_id,
+                prompt_source: crate::execution::PublicPromptArgs {
+                    prompt: Some(prompt),
+                    prompt_file: None,
+                },
+                json: false,
+            }),
+        };
+        let install_context =
+            crate::execution::install_bootstrap::checked_install_bootstrap_context_from_projections(
+            )
+            .context("load authority-managed targeted Turn install context")?;
+        Ok(crate::execution::handle_agent_command(
+            &command,
+            &cli,
+            &install_context,
+        ))
+    })
+    .await
+    .context("join authority-managed targeted Turn controller")??;
+    if exit_code != 0 {
+        anyhow::bail!(
+            "substrate: error: authority-managed targeted Turn exited with status {exit_code}"
+        );
+    }
+    Ok(())
+}
