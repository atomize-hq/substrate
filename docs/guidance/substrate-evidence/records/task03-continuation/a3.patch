+            .pointer("/state/value/post_turn/value/resulting_posture/kind")
+            .and_then(Value::as_str),
+        Some("ParkedResumable")
+    );
+    let resumed_participant_id = resume
+        .get("target_authoritative_participant_id")
+        .and_then(Value::as_str)
+        .expect("ResumeOneTurn target participant");
+    assert_eq!(
+        resume
+            .get("source_authoritative_participant_id")
+            .and_then(Value::as_str),
+        Some(initial_participant_id.as_str()),
+        "ResumeOneTurn must bind the exact source participant"
+    );
+    assert_eq!(
+        settled_resume
+            .get("active_authoritative_participant_id")
+            .and_then(Value::as_str),
+        Some(resumed_participant_id),
+        "terminal settlement must retain the exact revision-authorized successor participant"
+    );
+    assert_eq!(
+        settled_resume.get("world_binding"),
+        Some(&initial_world_binding),
+        "ResumeOneTurn must preserve exact world identity"
+    );
+    let resumed_handle_ref = settled_resume
+        .get("internal_resume_handle_refs")
+        .and_then(Value::as_array)
+        .and_then(|refs| refs.last())
+        .cloned()
+        .expect("resumed durable handle");
+    let resumed_handle = read_hsa_resume_handle(&substrate_home, &resumed_handle_ref);
+    assert_eq!(
+        resumed_handle
+            .get("internal_uaa_session_id")
+            .and_then(Value::as_str),
+        Some(continuity_uaa_session_id.as_str()),
+        "ResumeOneTurn must preserve exact UAA/provider handle continuity"
+    );
+    assert_eq!(
+        read_invocation_count(&host_invocation_count_path),
+        2,
+        "Start and resumed Turn must each submit their one real prompt exactly once"
+    );
+    let second_args = fs::read_to_string(temp.path().join("fake-codex-memory-2.args"))
+        .expect("read resumed provider args");
+    assert!(second_args.lines().any(|line| line == "resume"));
+    assert!(second_args
+        .lines()
+        .any(|line| line == continuity_uaa_session_id));
+    let second_stdin = fs::read_to_string(temp.path().join("fake-codex-memory-2.stdin"))
+        .expect("read resumed provider stdin");
+    assert_eq!(
+        second_stdin.matches(resumed_prompt).count(),
+        1,
+        "the real resumed prompt must be submitted exactly once"
+    );
+    assert!(!second_stdin.contains("Enter persistent Substrate host orchestrator mode."));
+    assert!(!second_stdin.contains("First visible operator request:"));
+    assert!(
+        !orchestration_session_path(&substrate_home, &orchestration_session_id).exists()
+            && !canonical_participant_path(
+                &substrate_home,
+                &orchestration_session_id,
+                resumed_participant_id,
+            )
+            .exists(),
+        "HSA ResumeOneTurn must perform zero legacy authority writes"
+    );
+
+    let retry_output = std::process::Command::new(binary_path())
+        .current_dir(&project)
+        .env("HOME", &home)
+        .env("USERPROFILE", &home)
+        .env("SUBSTRATE_HOME", &substrate_home)
+        .env("SUBSTRATE_MANAGER_MANIFEST", manager_manifest_path())
+        .env("SUBSTRATE_WORLD_SOCKET", &sock)
+        .env("SUBSTRATE_OVERRIDE_WORLD", "enabled")
+        .env(
+            "SUBSTRATE_WORLD_DEPS_GUEST_BIN_DIR",
+            substrate_home.join("world-deps-bin"),
+        )
+        .env_remove("SHIM_ORIGINAL_PATH")
+        .args([
+            "--install-prefix",
+            install_prefix.as_str(),
+            "--world",
+            "agent",
+            "turn",
+            "--session",
+            orchestration_session_id.as_str(),
+            "--backend",
+            "cli:codex-host",
+            "--prompt",
+            resumed_prompt,
+            "--json",
+        ])
+        .output()
+        .expect("retry exact settled public Turn");
+    assert!(
+        retry_output.status.success(),
+        "exact settled Turn retry must join: {retry_output:?}"
+    );
+    assert_eq!(
+        read_invocation_count(&host_invocation_count_path),
+        2,
+        "exact retry after settlement must not replay provider submission"
+    );
+
+    repl.send_line("exit");
+    let (_code, _out) = repl.shutdown_graceful(Duration::from_secs(5));
+}
