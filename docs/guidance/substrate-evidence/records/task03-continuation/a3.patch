+/// Adapts an exact native provider turn terminal into the existing HSA
+/// resumable-clean cut when the canonical world-work registry proves that the
+/// turn accepted no retained world work. The accepted HSA input is the work
+/// acceptance, and the typed provider event is the sole materialized terminal
+/// event; callers must prefer the canonical retained-work cut whenever one
+/// exists.
+fn direct_provider_terminal_obligation_cut(
+    current: &HostSessionTransitionIntentV3,
+    authority_revision_observed: u64,
+    authority_store_id: &str,
+    correlation: &HostTransitionWorkCorrelationV1,
+    terminal: &AuthoritativeStartTerminalEvidenceV1,
+) -> std::result::Result<ObligationLedgerSnapshotReadV1, RuntimeBootstrapFailure> {
+    let failure = |message: String| RuntimeBootstrapFailure {
+        exit_code: 1,
+        message: format!("authority-managed ResumeOneTurn reconciliation failed: {message}"),
+    };
+    if terminal.phase != TurnLifecyclePhaseV1::Completed
+        || !matches!(
+            terminal.provider_event_kind.as_str(),
+            "turn.completed" | "result.success"
+        )
+        || terminal.thread_id.trim().is_empty()
+        || terminal.turn_id.trim().is_empty()
+        || terminal.raw_event_sha256.len() != 64
+        || !terminal
+            .raw_event_sha256
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit())
+    {
+        return Err(failure(
+            "direct provider cut requires exact typed successful terminal evidence".to_string(),
+        ));
+    }
+    let HostSessionTransitionInputHandoffV1::Accepted {
+        input_ref,
+        run_id,
+        acceptance_ref,
+        ..
+    } = &current.input_handoff
+    else {
+        return Err(failure(
+            "typed provider completion requires exact accepted input evidence".to_string(),
+        ));
+    };
+    if current.transition_input_ref.as_ref() != Some(input_ref) || run_id != &current.run_id {
+        return Err(failure(
+            "typed provider completion input identity changed".to_string(),
+        ));
+    }
+    let completed_at = successor_timestamp_now()?;
+    let captured_at = chrono::DateTime::parse_from_rfc3339(completed_at.as_str())
+        .map_err(|error| failure(error.to_string()))?
+        .with_timezone(&chrono::Utc);
+    let event_id = resume_turn_completion_evidence_id(current, terminal);
+    let stream_id = format!("provider-{}", &event_id[4..36]);
+    let acceptance_record_id = acceptance_ref.ref_id.clone();
+    let acceptance_record_revision = current.intent_revision;
+    let accepted_work_identity = AcceptedWorldWorkIdentityV1::RetainedTurn {
+        active_run_id: current.run_id.clone(),
+        message_id: terminal.turn_id.clone(),
+        target_participant_id: current.target_authoritative_participant_id.clone(),
+    };
+    let terminal_event = SupervisorJournalEventRefV1 {
+        schema_version: 1,
+        journal_entry_id: format!("provider-{event_id}"),
+        acceptance_record_id: acceptance_record_id.clone(),
+        acceptance_record_revision,
+        accepted_work_identity: accepted_work_identity.clone(),
+        stream_id: stream_id.clone(),
+        frame_sequence: 1,
+        event_id: event_id.clone(),
+        event_sequence: 1,
+        transport_event_commitment: AuthorityObjectCommitmentV1::CanonicalSha256 {
+            digest_hex: terminal.raw_event_sha256.clone(),
+        },
+    };
+    Ok(ObligationLedgerSnapshotReadV1::Complete {
+        snapshot: ObligationSnapshotHashInputV1 {
+            schema_version: 1,
+            authority_store_id: authority_store_id.to_string(),
+            orchestration_session_id: current.orchestration_session_id.clone(),
+            authoritative_participant_id: current.target_authoritative_participant_id.clone(),
+            acceptance_record_id: acceptance_record_id.clone(),
+            acceptance_record_revision,
+            stream_id: stream_id.clone(),
+            accepted_work_identity,
+            host_transition_correlation: correlation.clone(),
+            transition_intent_id: current.intent_id.clone(),
+            transition_run_id: current.run_id.clone(),
+            authority_revision_observed,
+            materialization_cut: ObligationMaterializationCutV1 {
+                acceptance_record_id,
+                acceptance_record_revision,
+                stream_id,
+                session_ledger_revision: current.intent_revision,
+                terminal_event_id: event_id,
+                terminal_event_sequence: 1,
+                materialized_through_event_sequence: 1,
+            },
+            materialized_journal_events: vec![terminal_event],
+            attention_disposition: ObligationAttentionDispositionV1::NoUnresolvedAttention,
+            unresolved_attention_obligations: Vec::new(),
+            captured_at,
+        },
+    })
+}
