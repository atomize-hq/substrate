+#[cfg(target_os = "linux")]
+fn read_hsa_root(substrate_home: &Path) -> Value {
+    serde_json::from_str(
+        &fs::read_to_string(substrate_home.join("authority-v1/state-root-v1.json"))
+            .expect("read HSA root"),
+    )
+    .expect("parse HSA root")
+}
+
+#[cfg(target_os = "linux")]
+fn read_hsa_authority(substrate_home: &Path, orchestration_session_id: &str) -> Value {
+    let root = read_hsa_root(substrate_home);
+    let record = root
+        .get("session_namespace_map")
+        .and_then(|sessions| sessions.get(orchestration_session_id))
+        .unwrap_or_else(|| panic!("missing HSA session {orchestration_session_id}: {root}"));
+    assert_eq!(
+        record.get("kind").and_then(Value::as_str),
+        Some("Authority")
+    );
+    record.get("value").cloned().expect("HSA authority value")
+}
+
+#[cfg(target_os = "linux")]
+fn wait_for_hsa_posture(
+    substrate_home: &Path,
+    orchestration_session_id: &str,
+    expected_posture: &str,
+    timeout: Duration,
+) -> Value {
+    let deadline = Instant::now() + timeout;
+    while Instant::now() < deadline {
+        let authority = read_hsa_authority(substrate_home, orchestration_session_id);
+        if authority
+            .pointer("/lifecycle_posture/kind")
+            .and_then(Value::as_str)
+            == Some(expected_posture)
+        {
+            return authority;
+        }
+        std::thread::sleep(Duration::from_millis(25));
+    }
+    panic!(
+        "timed out waiting for HSA posture {expected_posture}: {}",
+        read_hsa_authority(substrate_home, orchestration_session_id)
+    );
+}
+
+#[cfg(target_os = "linux")]
+fn read_hsa_resume_handle(substrate_home: &Path, reference: &Value) -> Value {
+    let ref_id = reference
