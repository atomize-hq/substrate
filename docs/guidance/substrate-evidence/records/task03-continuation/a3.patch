+        .expect("resume handle ref_id");
+    let schema_version = reference
+        .get("schema_version")
+        .and_then(Value::as_u64)
+        .expect("resume handle schema version");
+    serde_json::from_str(
+        &fs::read_to_string(
+            substrate_home
+                .join(format!(
+                    "authority-v1/objects/resume-handle/v{schema_version}"
+                ))
+                .join(format!("{ref_id}.obj")),
+        )
+        .expect("read HSA resume handle"),
+    )
+    .expect("parse HSA resume handle")
+}
