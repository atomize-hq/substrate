+#[cfg(target_os = "linux")]
+async fn start_authority_managed_targeted_runtime(
+    prepared: PreparedAgentRuntime,
+    initial_world_binding: Option<&PersistedWorldBinding>,
+    prompt: &str,
+    startup_toolbox_request_tx: &InternalToolboxDispatchRequestSender,
+    agent_printer: &ReplPrinter,
+    telemetry: &mut ReplSessionTelemetry,
+) -> std::result::Result<Option<AsyncReplAgentRuntime>, RuntimeBootstrapFailure> {
+    let orchestration_session_id = prepared.startup_context.orchestration_session_id();
+    let participant_id = prepared
+        .manifest
+        .lock()
+        .expect("prepared runtime manifest mutex poisoned")
+        .handle
+        .participant_id
+        .clone();
+    let listener =
+        register_durable_start_startup_prompt_listener(&orchestration_session_id, &participant_id)
+            .map_err(|error| RuntimeBootstrapFailure {
+                exit_code: 1,
+                message: format!(
+                    "failed to register targeted HSA Start lifecycle stream: {error:#}"
+                ),
+            })?;
+    let stream_path = listener.path().to_path_buf();
+    let startup = start_host_orchestrator_runtime_with_prepared_prompt_and_toolbox_request_tx(
+        Some(prepared),
+        initial_world_binding,
+        Some(InitialExecPromptPlan::StartupPrompt {
+            prompt: prompt.to_string(),
+            stream_path,
+        }),
+        false,
+        true,
+        true,
+        Some(startup_toolbox_request_tx),
+        None,
+        agent_printer,
+        telemetry,
+    );
+    let lifecycle = consume_hidden_owner_helper_startup_prompt_stream(listener, |_| Ok(()));
+    let (runtime, lifecycle) = tokio::join!(startup, lifecycle);
+    let runtime = runtime?;
+    let lifecycle_exit_code = lifecycle.map_err(|error| RuntimeBootstrapFailure {
+        exit_code: 1,
+        message: format!("targeted HSA Start lifecycle stream failed: {error:#}"),
+    })?;
+    if lifecycle_exit_code != 0 {
+        return Err(RuntimeBootstrapFailure {
+            exit_code: lifecycle_exit_code,
+            message: format!(
+                "targeted HSA Start lifecycle stream exited with status {lifecycle_exit_code}"
+            ),
+        });
+    }
+    if let Some(runtime) = runtime {
+        retire_authority_managed_targeted_runtime(runtime).await;
+    }
+    Ok(None)
+}
