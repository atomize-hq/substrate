+    #[test]
+    fn test_direct_host_inbox_ingress_unbound_and_bound_share_immutable_arrival() {
+        let (home, unbound) = ingress_home(true);
+        let identity = TrustedAuthorityRoot::open(home.path())
+            .unwrap()
+            .identity()
+            .clone();
+        let bound = AgentRuntimeStateStore {
+            substrate_home: home.path().to_path_buf(),
+            bootstrap_home: Some(identity.clone()),
+        };
+        let record = ingress_request("same-arrival");
+        unbound.persist_host_inbox_record(&record).unwrap();
+        bound.persist_host_inbox_record(&record).unwrap();
+        with_locked_direct_host_inbox_transaction(home.path(), Some(&identity), |tx| {
+            let source = read_direct_host_inbox_source(tx)?;
+            assert_eq!(source.receipts.len(), 1);
+            assert_eq!(source.receipts[0].1.receipt_id, record.record_id);
+            Ok(())
+        })
+        .unwrap();
+        let mut conflicting = record.clone();
+        conflicting.summary = "changed".into();
+        assert!(bound.persist_host_inbox_record(&conflicting).is_err());
+        assert_eq!(
+            unbound.load_host_inbox_record(&record.record_id).unwrap(),
+            Some(record)
+        );
+    }
+
+    #[test]
+    fn test_direct_host_inbox_ingress_invalid_retry_preserves_original_receipt_and_marker() {
+        let (home, store) = ingress_home(true);
+        let source_path = home.path().join("host_inbox/bad.name");
+        let first = store
+            .record_invalid_host_inbox_artifact_failure(&source_path)
+            .unwrap();
+        let marker = store
+            .invalid_host_inbox_artifact_record_path(&first.record_id)
+            .unwrap();
+        let original = fs::read(&marker).unwrap();
+        // Model the receipt-before-marker crash boundary using only raw
+        // failure artifacts, without inserting any canonical ledger record.
+        fs::remove_file(&marker).unwrap();
+        let second = store
+            .record_invalid_host_inbox_artifact_failure(&source_path)
+            .unwrap();
+        assert_eq!(first, second);
+        assert_eq!(fs::read(&marker).unwrap(), original);
+        with_locked_direct_host_inbox_transaction(home.path(), None, |tx| {
+            let source = read_direct_host_inbox_source(tx)?;
+            assert_eq!(source.receipts.len(), 1);
+            assert!(matches!(&source.receipts[0].1.arrival,
+                DirectHostInboxArrivalV1::InvalidArtifact { failure_bytes, .. } if failure_bytes == &original));
+            Ok(())
+        }).unwrap();
+    }
