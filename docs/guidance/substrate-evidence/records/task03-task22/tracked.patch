+    fn ingress_request(id: &str) -> HostInboxRecord {
+        HostInboxRecord::new(
+            "session",
+            id,
+            OrchestrationObligationKind::FollowUpRequired,
+            "unverified request",
+            "local-host",
+            "input-claim",
+            "sender-claim",
+        )
+    }
