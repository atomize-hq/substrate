+                ),
+            );
+            if m.is_dir() {
+                for entry in fs::read_dir(path).unwrap() {
+                    walk(root, &entry.unwrap().path(), state);
+                }
+            }
+        }
+        let mut state = BTreeMap::new();
+        walk(root, root, &mut state);
+        state
