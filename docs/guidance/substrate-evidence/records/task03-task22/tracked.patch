+impl WorkspaceNativePeerV1 {
+    pub fn capture_linux_uds_v1(stream: &tokio::net::UnixStream) -> Result<Self, &'static str> {
+        let peer = stream.peer_cred().map_err(|_| "Denied")?;
+        if peer.pid().is_none() {
+            return Err("Denied");
+        }
+        Ok(Self { uid: peer.uid() })
