+    fn ingress_home(activated: bool) -> (tempfile::TempDir, AgentRuntimeStateStore) {
+        let parent = std::env::var_os("XDG_RUNTIME_DIR").expect("private fixture parent");
+        let home = tempfile::tempdir_in(parent).unwrap();
+        fs::set_permissions(home.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        if activated {
+            bootstrap(home.path()).unwrap();
+        }
+        let store = AgentRuntimeStateStore {
+            substrate_home: home.path().to_path_buf(),
+            bootstrap_home: None,
+        };
+        (home, store)
+    }
