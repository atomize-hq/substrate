+/// Raw arrival owns no canonical attention meaning. Every Linux physical
+/// ingress route takes the same retained root lock as Resume materialization
+/// and HSA settlement, including pre-activation and invalid artifacts.
+#[cfg(target_os = "linux")]
+impl AgentRuntimeStateStore {
+    fn persist_direct_host_inbox_ingress(&self, record: &HostInboxRecord) -> Result<()> {
+        use super::host_session_authority::store::{
+            with_locked_direct_host_inbox_transaction, BootstrapError,
+            DirectHostInboxStorageAreaV1 as Area,
+        };
+        self.validate_host_inbox_record(record)?;
+        let file_name = Self::host_inbox_record_file_name(&record.record_id)?;
+        with_locked_direct_host_inbox_transaction(
+            &self.substrate_home,
+            self.bootstrap_home.as_ref(),
+            |tx| {
+                if tx.authority_root().is_some() {
+                    super::obligation_ledger::direct_host_inbox::publish_direct_host_inbox_request(
+                        tx, record,
+                    )?;
+                } else {
+                    // Before activation there is no authenticated store ID or
+                    // source enrollment. Preserve legacy bytes/updates under
+                    // the physical lock; subsequent birth treats unreceipted
+                    // artifacts as incomplete rather than inventing history.
+                    let bytes = serde_json::to_vec_pretty(record).map_err(|_| {
+                        BootstrapError::direct_host_inbox("encode pre-activation inbox request")
+                    })?;
+                    let old = tx.read_file(Area::RawInbox, &[&file_name])?;
+                    if old.as_deref() != Some(bytes.as_slice()) {
+                        tx.write_file(Area::RawInbox, &[&file_name], old.as_deref(), &bytes)?;
+                    }
+                }
+                tx.verify()
+            },
+        )
+        .context("publish retained host inbox ingress")
+    }
+
+    fn record_direct_host_invalid_ingress(&self, path: &Path) -> Result<HostInboxRecord> {
+        use super::host_session_authority::store::{
+            with_locked_direct_host_inbox_transaction, BootstrapError,
+            DirectHostInboxStorageAreaV1 as Area,
+        };
+        use super::obligation_ledger::direct_host_inbox::{
+            publish_direct_host_inbox_arrival, read_direct_host_inbox_source,
+            DirectHostInboxArrivalV1,
+        };
+        let record_id = Self::invalid_host_inbox_artifact_record_id(path);
+        let reason = match Self::host_inbox_record_id_from_path(path) {
+            Ok(_) => format!("invalid_host_inbox_artifact_path: {}", path.display()),
+            Err(err) => format!("invalid_host_inbox_artifact_path: {err:#}"),
+        };
+        let file_name = Self::host_inbox_record_file_name(&record_id)?;
+        with_locked_direct_host_inbox_transaction(
+            &self.substrate_home,
+            self.bootstrap_home.as_ref(),
+            |tx| {
+                let old = tx.read_file(Area::RawInbox, &[".invalid_artifacts", &file_name])?;
+                let activated = tx.authority_root().is_some();
+                // The receipt can precede the compatibility marker on a crash.
+                // Recover its original timestamp/bytes instead of minting a
+                // second arrival or rewriting prior evidence.
+                let receipt_bytes = if activated {
+                    read_direct_host_inbox_source(tx)?
+                        .receipts
+                        .into_iter()
+                        .find(|(_, receipt)| receipt.receipt_id == record_id)
+                        .map(|(_, receipt)| match receipt.arrival {
+                            DirectHostInboxArrivalV1::InvalidArtifact {
+                                artifact_name,
+                                failure_bytes,
+                            } if artifact_name == file_name => Ok(failure_bytes),
+                            _ => Err(BootstrapError::direct_host_inbox(
+                                "invalid ingress receipt ID has different provenance",
+                            )),
+                        })
+                        .transpose()?
+                } else {
+                    None
+                };
+                let existing = receipt_bytes
+                    .as_ref()
+                    .or(old.as_ref())
+                    .map(|bytes| {
+                        serde_json::from_slice::<HostInboxRecord>(bytes).map_err(|_| {
+                            BootstrapError::direct_host_inbox(
+                                "decode retained invalid inbox marker",
+                            )
+                        })
+                    })
+                    .transpose()?;
+                let record = if let Some(existing) = existing {
+                    self.validate_host_inbox_record(&existing).map_err(|_| {
+                        BootstrapError::direct_host_inbox("validate retained invalid inbox marker")
+                    })?;
+                    if existing.record_id != record_id
+                        || existing.materialization_state
+                            != HostInboxMaterializationState::FailedClosed
+                        || existing.failed_closed_reason.as_deref() != Some(reason.as_str())
+                    {
+                        return Err(BootstrapError::direct_host_inbox(
+                            "invalid inbox marker conflicts with original failure",
+                        ));
+                    }
+                    existing
+                } else {
+                    let mut record = HostInboxRecord::new(
+                        String::new(),
+                        record_id.clone(),
+                        OrchestrationObligationKind::RuntimeAlert,
+                        "malformed host inbox artifact",
+                        String::new(),
+                        String::new(),
+                        String::new(),
+                    );
+                    record.severity = OrchestrationObligationSeverity::Error;
+                    record.created_at = Utc::now();
+                    record.ingress_received_at = record.created_at;
+                    record.mark_failed_closed(reason.clone(), record.created_at);
+                    record
+                };
+                self.validate_host_inbox_record(&record).map_err(|_| {
+                    BootstrapError::direct_host_inbox("validate invalid inbox ingress")
+                })?;
+                let bytes = match receipt_bytes {
+                    Some(bytes) => bytes,
+                    None => serde_json::to_vec_pretty(&record).map_err(|_| {
+                        BootstrapError::direct_host_inbox("encode invalid inbox ingress")
+                    })?,
+                };
+                if old.as_ref().is_some_and(|old| old != &bytes) {
+                    return Err(BootstrapError::direct_host_inbox(
+                        "invalid inbox marker bytes conflict with receipt",
+                    ));
+                }
+                if activated {
+                    publish_direct_host_inbox_arrival(
+                        tx,
+                        &record_id,
+                        DirectHostInboxArrivalV1::InvalidArtifact {
+                            artifact_name: file_name.clone(),
+                            failure_bytes: bytes.clone(),
+                        },
+                    )?;
+                }
+                if old.is_none() {
+                    tx.write_file(
+                        Area::RawInbox,
+                        &[".invalid_artifacts", &file_name],
+                        None,
+                        &bytes,
+                    )?;
+                }
+                tx.verify()?;
+                Ok(record)
+            },
+        )
+        .context("publish retained invalid host inbox ingress")
+    }
+}
