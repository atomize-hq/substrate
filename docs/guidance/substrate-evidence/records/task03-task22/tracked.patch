+        assert!(value.validate().is_err()); // Post-acceptance launch failure is never pre-acceptance rejection.
+        value = event();
+        value.protocol_actor = HostPostTurnProtocolActorV1::TargetAuthoritativeParticipant {
+            participant_id: "other".into(),
