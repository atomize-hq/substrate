+}
+fn initialization_checkpoint_v1(phase: &str) -> anyhow::Result<()> {
+    #[cfg(test)]
+    return INITIALIZATION_HOOK_V1.with(|hook| match hook.borrow_mut().as_mut() {
+        Some(hook) => hook(phase),
+        None => Ok(()),
+    });
+    #[cfg(not(test))]
+    {
+        let _ = phase;
+        Ok(())
+    }
