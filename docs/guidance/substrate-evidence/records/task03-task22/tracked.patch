+    ) -> ApplyHostSessionTransitionRequestV1 {
+        let TransitionIssueOutcomeV1::Issued(issued) = authority
+            .issue_start_at(request, timestamp("2026-07-14T12:00:00.000000000Z"), 300)
+            .unwrap()
+        else {
