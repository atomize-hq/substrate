+            backend_id: "backend".into(),
+            protocol: "protocol".into(),
+            native_session_id: "thread".into(),
+            thread_id: "thread".into(),
+            turn_id: "turn".into(),
+            sequence: DirectHostNativeSequenceV1::Codex {
+                resumed_thread_id: "thread".into(),
+                started_turn_id: "turn".into(),
