+    #[derive(PartialEq, Eq)]
+    struct EntryState {
+        metadata: (u64, u64, u32, u32, u32, u64, u64, i64, i64, i64, i64),
+        bytes: Vec<u8>,
+        link: Option<std::path::PathBuf>,
+    }
+
+    fn tree(root: &std::path::Path) -> BTreeMap<std::path::PathBuf, EntryState> {
+        fn visit(
+            root: &std::path::Path,
+            path: &std::path::Path,
+            result: &mut BTreeMap<std::path::PathBuf, EntryState>,
+        ) {
+            let metadata = fs::symlink_metadata(path).unwrap();
+            result.insert(
+                path.strip_prefix(root).unwrap().to_owned(),
+                EntryState {
+                    metadata: (
+                        metadata.dev(),
+                        metadata.ino(),
+                        metadata.mode(),
+                        metadata.uid(),
+                        metadata.gid(),
+                        metadata.nlink(),
+                        metadata.len(),
+                        metadata.mtime(),
+                        metadata.mtime_nsec(),
+                        metadata.ctime(),
+                        metadata.ctime_nsec(),
+                    ),
+                    bytes: if metadata.is_file() {
+                        fs::read(path).unwrap()
+                    } else {
+                        Vec::new()
+                    },
+                    link: metadata
+                        .file_type()
+                        .is_symlink()
+                        .then(|| fs::read_link(path).unwrap()),
+                },
+            );
+            if metadata.is_dir() {
+                for entry in fs::read_dir(path).unwrap() {
+                    visit(root, &entry.unwrap().path(), result);
+                }
+            }
+        }
+        let mut result = BTreeMap::new();
+        visit(root, root, &mut result);
+        result
+    }
