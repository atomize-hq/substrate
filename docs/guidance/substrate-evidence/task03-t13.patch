+                    exchange_id: "schema-binding-exchange".into(),
+                    exchange_sequence: 1,
+                    provider_event_kind: "thread.started".into(),
+                    evidence_sha256: "ab".repeat(32),
+                    observed_at: TimestampV1::parse("2026-10-27T12:05:00.000000000Z").unwrap(),
+                },
