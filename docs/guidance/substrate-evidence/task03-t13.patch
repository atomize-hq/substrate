+        #[test]
+        fn test_schema_1_and_2_production_published_objects_read_in_v2_and_v3() {
+            for v3 in [false, true] {
+                let (fixture, references) = published(v3);
+                let before = tree(fixture.home.path());
+                for reference in references {
+                    assert_eq!(
