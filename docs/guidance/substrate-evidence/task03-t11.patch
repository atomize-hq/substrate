+/// Uses the same authenticated config/account preparation and lifecycle transport
+/// as world gateway sync; the native child receives only the returned loopback URL.
+#[cfg(target_os = "linux")]
+pub(crate) fn prepare_initial_codex_gateway(
+    accepted_home: &Path,
+    cwd: &Path,
+    backend: &str,
+    model: transport_api_types::InitialCodexModel,
+) -> anyhow::Result<String> {
+    let (principal, _) = crate::execution::install_bootstrap::current_unix_principal_and_home()?;
+    let transport_api_types::PlatformPrincipalV1::Unix { account, uid } = principal else {
+        anyhow::bail!("initial gateway requires Unix principal");
+    };
+    let context = transport_api_types::InstallBootstrapContextV1::new_unix(
+        accepted_home
+            .to_str()
+            .ok_or_else(|| anyhow::anyhow!("accepted home is not UTF-8"))?,
+        &account,
+        uid,
+    )?;
+    let carrier = InstallBootstrapContextCarrierV1::from_context(context)?;
+    let request = build_gateway_request_context_with_selection(
+        false,
+        false,
+        cwd,
+        &carrier,
+        Some((backend, model)),
+    )?;
+    #[cfg(test)]
+    let controlled = INITIAL_GATEWAY_TEST_TRANSPORT.with(|slot| {
+        slot.borrow()
+            .as_ref()
+            .map(|transport| transport(&request.request))
+    });
+    #[cfg(not(test))]
+    let controlled: Option<anyhow::Result<GatewayLifecycleResponseV1>> = None;
+    let response = match controlled {
+        Some(response) => response?,
+        None => call_gateway_action(GatewayAction::Sync, &request)?,
+    };
+    let wiring = response
+        .client_wiring
+        .ok_or_else(|| anyhow::anyhow!("managed gateway is unavailable"))?;
+    Ok(format!(
+        "{}/v1",
+        wiring.openai_base_url.trim_end_matches('/')
+    ))
+}
