+#[cfg(test)]
+pub(crate) fn with_initial_gateway_test_transport<T>(
+    transport: impl Fn(&GatewayLifecycleRequestV1) -> anyhow::Result<GatewayLifecycleResponseV1>
+        + 'static,
+    test: impl FnOnce() -> T,
+) -> T {
+    struct Reset;
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            INITIAL_GATEWAY_TEST_TRANSPORT.with(|slot| {
+                slot.borrow_mut().take();
+            });
+        }
+    }
+    INITIAL_GATEWAY_TEST_TRANSPORT
+        .with(|slot| assert!(slot.borrow_mut().replace(Box::new(transport)).is_none()));
+    let _reset = Reset;
+    test()
+}
