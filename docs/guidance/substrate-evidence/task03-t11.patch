+/// Supported immutable initial Codex model. Omission retains the existing route.
+///
+/// ```
+/// use transport_api_types::InitialCodexModel;
+/// assert_eq!("gpt-6-astra".parse::<InitialCodexModel>().unwrap().as_str(), "gpt-6-astra");
+/// assert!("codex".parse::<InitialCodexModel>().is_err());
+/// ```
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize, Deserialize)]
+pub enum InitialCodexModel {
+    #[serde(rename = "gpt-6-astra")]
+    Gpt6Astra,
+}
+
+impl InitialCodexModel {
+    pub const fn as_str(self) -> &'static str {
+        "gpt-6-astra"
+    }
+}
+
+impl std::str::FromStr for InitialCodexModel {
+    type Err = String;
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        match value {
+            "gpt-6-astra" => Ok(Self::Gpt6Astra),
+            _ => Err("unsupported initial model; expected exact gpt-6-astra".to_string()),
+        }
+    }
+}
