  "archive_root_cause": {
    "old_skill_instruction": "Persist the verified receipt, update state, archive the completed task, and only then dispatch the next increment.",
    "direct_discard_instruction_present": false,
    "observed_app_side_effect": "Archiving removed the assigned disposable worktree; unarchiving did not restore it.",
    "operator_error": "The success-path archive instruction was incorrectly applied to a blocked task."
  },
  "fixes": [
    "Never automatically archive any task.",
    "Never archive blocked, failed, authority-required, base-drift, non-success, dirty, staged, untracked, or unique-state tasks.",
    "Archiving is not a completion gate or successor-dispatch prerequisite.",
    "Archive only with explicit user authorization and persisted disposal-safety proof.",
    "Keep the complete skill suite repository-local and prohibit global installation or registration.",
    "Hydrate and digest-verify the complete repository-local .agents/skills suite in every fresh meta, increment, evidence, and auxiliary top-level task worktree before authority binding.",
    "Refuse to overwrite an arbitrary differing task-local skill suite.",
    "Permit only a verified exact legacy single-orchestrator-skill migration; otherwise stop for reconciliation.",
    "Keep initialization prompts self-contained until the hydrated suite can load on the binding turn."
  ],
