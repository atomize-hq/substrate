    "observed_app_side_effect": "Archiving removed the assigned disposable worktree; unarchiving did not restore it.",
    "operator_error": "The success-path archive instruction was incorrectly applied to a blocked task."
  },
  "fixes": [
    "Never automatically archive any task.",
    "Never archive blocked, failed, authority-required, base-drift, non-success, dirty, staged, untracked, or unique-state tasks.",
    "Archiving is not a completion gate or successor-dispatch prerequisite.",
    "Archive only with explicit user authorization and persisted disposal-safety proof.",
    "Keep this skill repository-local and prohibit global installation or registration.",
    "Hydrate and digest-verify the repository-local skill in each fresh meta, increment, and evidence task worktree before authority binding.",
    "Refuse to overwrite a missing-path mismatch or differing task-local skill.",
    "Keep initialization prompts self-contained until the hydrated skill can load on the binding turn."
  ],
