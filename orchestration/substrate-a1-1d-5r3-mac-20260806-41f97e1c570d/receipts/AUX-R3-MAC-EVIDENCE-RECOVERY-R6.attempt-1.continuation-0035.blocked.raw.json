    "findings": [
      {
        "id": "P1-R6-OPERATOR-TTY-PIPE-RELAY",
        "priority": "P1",
        "evidence": "macOS relays the retained host terminal through the operator child stdin pipe instead of direct guest-TTY-only input."
      },
      {
        "id": "P1-R6-DATA-DERIVED-CONFIRMATION",
        "priority": "P1",
        "evidence": "The data branch derives commitment from ticket and binding values before independently proving TTY entry."
      },
      {
        "id": "P1-R6-REJOIN-GENERATION-MISMATCH",
        "priority": "P1",
        "evidence": "The immutable binding generation is reused as the mutable current generation after CAS."
      },
      {
        "id": "P1-R6-PREINTENT-REUSE",
        "priority": "P1",
        "evidence": "Pre-intent loss can reuse guest_state_root_prepared instead of allocating a fresh two-session attempt."
      },
      {
        "id": "P1-R6-CONSUME-RETRY-NONIDEMPOTENT",
        "priority": "P1",
        "evidence": "The guest consumed marker rejects the exact retry that the host recovery path admits."
      },
      {
        "id": "P1-R6-EXPIRY-MUTATION",
        "priority": "P1",
        "evidence": "An expired active record falls through to replacement issuance instead of immutable preservation."
      },
      {
        "id": "P2-R6-UNAUTHORIZED-PUBLIC-TERMINAL-API",
        "priority": "P2",
        "evidence": "Broad public terminal-FD APIs exceed the minimum private-helper fence."
      },
      {
        "id": "P2-R6-EXPIRY-EQUALITY",
        "priority": "P2",
        "evidence": "The guest accepts now equal to expires while canonical host validation rejects it."
      },
      {
        "id": "P2-R6-CONFIRMATION-PROJECTION",
        "priority": "P2",
        "evidence": "Guest PTY output is wholesale relayed and terminal input lacks echo suppression."
      },
      {
        "id": "P2-R6-PROOF-GAPS",
        "priority": "P2",
        "evidence": "Existing static tests do not execute the required loss, replay, terminal, selector, and expiry boundaries."
      }
    ]
  },
