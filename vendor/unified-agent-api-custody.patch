+async fn admitted(path: &Path) {
+    tokio::time::timeout(Duration::from_secs(3), async {
+        loop {
+            if std::fs::metadata(path)
+                .map(|m| m.len() != 0)
+                .unwrap_or(false)
+            {
+                return;
+            }
+            tokio::time::sleep(Duration::from_millis(2)).await;
+        }
+    })
+    .await
+    .expect("real fixture child admission");
+}
