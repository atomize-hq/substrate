+/// Checked child/stdio settlement failed. Messages contain only failure categories.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ExecSettlementError {
+    mask: u8,
+}
+impl std::fmt::Display for ExecSettlementError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "process settlement failed (categories={:#04x})",
+            self.mask
+        )
+    }
+}
+impl std::error::Error for ExecSettlementError {}
