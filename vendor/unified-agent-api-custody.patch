+async fn read_stderr(mut reader: tokio::process::ChildStderr, mirror: bool) -> io::Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    let mut chunk = [0; 4096];
+    let mut console = tokio::io::stderr();
+    loop {
+        let count = reader.read(&mut chunk).await?;
+        if count == 0 {
+            return Ok(bytes);
+        }
+        if mirror {
+            console.write_all(&chunk[..count]).await?;
+            console.flush().await?;
+        }
+        bytes.extend_from_slice(&chunk[..count]);
+    }
+}
+fn join_error(error: tokio::task::JoinError) -> io::Error {
+    io::Error::other(error)
+}
+fn copy_error(error: &io::Error) -> io::Error {
+    io::Error::new(error.kind(), error.to_string())
+}
