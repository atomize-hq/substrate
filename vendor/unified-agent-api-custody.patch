+    tokio::select! {
+        result = &mut startup => panic!("stdin fixture must block startup: {}", result.is_ok()),
+        _ = admitted(&marker) => {},
+    }
+    drop(startup);
+    tokio::time::timeout(Duration::from_secs(3), custody.settle())
+        .await
