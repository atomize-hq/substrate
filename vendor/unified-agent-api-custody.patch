+/// This task is never aborted when a public future is dropped.
+#[allow(clippy::too_many_arguments)]
+pub(crate) async fn drive_child<T, F, Fut>(
+    mut child: Child,
+    owner: ChildOwner,
+    input: Option<Vec<u8>>,
+    ignore_broken_pipe: bool,
+    timeout: Option<Duration>,
+    capture_stderr: bool,
+    mirror_stderr: bool,
