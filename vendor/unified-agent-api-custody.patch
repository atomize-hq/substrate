+/// Observed wait data for one actual child owner. Missing PID/status is
+/// explicitly unknown, including failed spawn or abandoned ownership. A
+/// snapshot alone is not checked settlement or permission to execute.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct ProcessTerminationObservation {
+    pub process_id: Option<u32>,
+    pub status: Option<ExitStatus>,
+    pub recovery_status: Option<ExitStatus>,
+}
+
+#[derive(Debug, Default)]
+struct State {
+    sealed: bool,
+    started: bool,
+    admission: Option<SpawnAdmission>,
+    cancelled: bool,
+    active: usize,
+    failures: u8,
+    terminations: Vec<ProcessTerminationObservation>,
+}
+#[derive(Debug, Default)]
+struct Inner {
+    state: Mutex<State>,
+    changed: Notify,
+    cancellation: Notify,
+    #[cfg(test)]
+    wait_observer: Mutex<Option<oneshot::Sender<()>>>,
+    #[cfg(test)]
+    fail_wait: AtomicBool,
+    #[cfg(test)]
+    fail_stderr: AtomicBool,
+    #[cfg(test)]
+    stdout_ack_gate: Mutex<Option<oneshot::Receiver<()>>>,
+    #[cfg(test)]
+    stdout_ack_observer: Mutex<Option<oneshot::Sender<()>>>,
+}
