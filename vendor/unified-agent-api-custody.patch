+fn fixture(dir: &Path) -> PathBuf {
+    let path = dir.join("fake-custody-claude");
+    std::fs::write(
+        &path,
+        "#!/bin/sh\nprintf '%s' \"$*\" > \"$READY\"\nexec /bin/sleep 30\n",
+    )
+    .unwrap();
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o700)).unwrap();
